MEMORY
{
    text : origin = $ORIGIN
}

SECTIONS
{
    GROUP:
    {
        $SECTIONS
        .stack ALIGN(0x100):{}
    } > text

    /* The game keeps a 64 KiB guard region between its data and the stack. */
    _stack_protect = ($LAST_SECTION_SYMBOL + SIZEOF($LAST_SECTION_NAME) + 0xFFF) & ~0xFFF;
    _stack_end = _stack_protect + 0x10000;
    _stack_addr = (_stack_end + 0x10000 + 0x7) & ~0x7;
    _db_stack_addr = (_stack_addr + 0x2000);
    _db_stack_end = _stack_addr;
    __ArenaLo = (_db_stack_addr + 0x1f) & ~0x1f;
    __ArenaHi = $ARENAHI;

    /* Functions the original link folded away, at the address of the copy that survived.
       tools/aliases.py fills this in for each version; see docs/code_merging.md. */
    $ALIASES
}

FORCEACTIVE
{
    $FORCEACTIVE
}
